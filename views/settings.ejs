<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta nazov="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spevnik</title>
    <link rel="icon" type="image/png" href="/img/bible.png">

    <script src="/js/min/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="view-container">
        
        <h3>Spárovať spevník</h3>
        <button onclick="pairSongs()">Spárovať</button>
        <p>Spárovanie načíta piesne z Google Sheets.</p>
        <p>Ak sa piesne nezobrazia v kontroléry tak obnovte stránku!</p>
    </div>
</body>

<script>

    function pairSongs() {
        $.ajax({
            url: '/pair-songs',
            method: 'POST',
            success: function(response) {
                console.log('Success:', response);
                alert('Spevník bol spárovaný');
            },
            error: function(xhr, status, error) {
                console.error('Error:', error);
                alert(`Spevník NEBOL spárovaný. Error: ${error}\n${xhr.responseText}`);
            }
        });
    }
</script>